// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PontoMidia {
  id                  Int      @id @default(autoincrement())
  nomeEmpresa         String   @map("nome_empresa")
  responsavel         String
  whatsapp            String
  instagramSite       String?  @map("instagram_site")
  cep                 String
  rua                 String
  numero              String
  complemento         String?
  bairro              String
  cidade              String
  uf                  String   @db.Char(2)
  categoria           String
  descricao           String
  possuiTv            Boolean  @map("possui_tv")
  quantidadeTvs       Int?     @map("quantidade_tvs")
  localInstalacao     String?  @map("local_instalacao")
  fluxoDiarioEstimado String   @map("fluxo_diario_estimado")
  tempoPermanencia    String   @map("tempo_permanencia")
  faixaEtariaPublico  String[] @map("faixa_etaria_publico")
  generoPublico       String   @map("genero_publico")
  horariosPico        String?  @map("horarios_pico")
  valorDesejado       String   @map("valor_desejado")
  categoriasRecusadas String[] @map("categorias_recusadas")
  intencaoReal        String   @map("intencao_real")
  aceitaContato       Boolean  @map("aceita_contato")
  criadoEm            DateTime @default(now()) @map("criado_em")

  @@index([cidade])
  @@map("pontos_midia")
}

model Anunciante {
  id                   Int      @id @default(autoincrement())
  nomeEmpresa          String   @map("nome_empresa")
  responsavel          String
  whatsapp             String
  instagramSite        String?  @map("instagram_site")
  cep                  String
  rua                  String
  numero               String
  complemento          String?
  bairro               String
  cidade               String
  uf                   String   @db.Char(2)
  categoria            String
  oQueAnunciar         String   @map("o_que_anunciar")
  descricaoAnuncio     String   @map("descricao_anuncio")
  preferenciaLocalizacao String @map("preferencia_localizacao")
  distanciaMaxima      String?  @map("distancia_maxima")
  bairrosEspecificos   String?  @map("bairros_especificos")
  categoriasEspecificas String[] @map("categorias_especificas")
  faixaEtariaAlvo      String[] @map("faixa_etaria_alvo")
  generoAlvo           String   @map("genero_alvo")
  valorInvestimento    String   @map("valor_investimento")
  jaInvestePublicidade Boolean  @map("ja_investe_publicidade")
  ondeInveste          String[] @map("onde_investe")
  intencaoReal         String   @map("intencao_real")
  aceitaContato        Boolean  @map("aceita_contato")
  criadoEm             DateTime @default(now()) @map("criado_em")

  @@index([cidade])
  @@map("anunciantes")
}